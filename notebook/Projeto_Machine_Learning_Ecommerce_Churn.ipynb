   "source": [
    "print(\n",
    "    \"KNN: o StandardScaler é ajustado exclusivamente no treino \"\n",
    "    \"já balanceado e depois aplicado ao teste.\"\n",
    ")\n",
    "print(\n",
    "    \"Árvore de Decisão: não recebe StandardScaler, pois seus cortes \"\n",
